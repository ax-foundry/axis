# Scorecards: YAML-driven dashboard definitions consumed by /api/scorecard/{name}/{view}.
#
# A scorecard names a (source_table, group_column) pair plus the metric list,
# anomaly rules, sentiment value-map, and detail-view projection. Every dataset-
# specific choice (which metric names matter, how 'critical' is defined, what
# sentiment values mean) lives here. The router itself is generic.
#
# Copy to custom/config/scorecards.yaml and edit per deployment.

scorecards:
  example:
    source_table: monitoring_data
    sentiment_table: human_signals_cases
    group_column: source_name        # the per-row "agent" pivot
    timestamp_column: timestamp

    # Applied to every view's WHERE clause.
    base_filters:
      - { col: environment, op: eq, value: production }
      - { col: eval_mode, op: eq, value: online }

    # Drives the summary view's filtered AVGs. Each entry becomes a column.
    metrics:
      - { name: faithfulness, match: "Faithfulness", agg: avg, col: metric_score }
      - { name: relevance,    match: "Relevance",    agg: avg, col: metric_score }

    # What counts as a failure, and which failures are 'critical'.
    anomaly:
      failure_filter:
        - { col: passed, op: eq, value: false }
      critical_rule:
        - { col: metric_name,  op: eq, value: "Step Reliability" }
        - { col: metric_score, op: eq, value: 0 }

    # Per-source sentiment scoring, sourced from a flattened signal column.
    sentiment:
      column: "Sentiment Category__sentiment"
      timestamp_column: "Timestamp"
      value_map:
        positive: 1.0
        neutral: 0.5
        frustrated: 0.0
        confused: 0.0

    # JSON blob columns to allow in detail_columns (projection only; filtering still blocked).
    # json_passthrough_columns: [signals]

    # Columns returned by /anomaly_detail. Validated against the live schema
    # at request time; blob columns (signals, evaluation_metadata, ...) are blocked
    # unless listed in json_passthrough_columns above.
    detail_columns:
      - dataset_id
      - run_id
      - metric_name
      - metric_score
      - explanation
      - timestamp

    # Per-agent signal counts from a cases/signals table (/signals and /signal_detail).
    # `table` defaults to sentiment_table when omitted.
    # `match_values` lists the values that count as "interesting" — omit to count any non-null row.
    # `detail_columns` are projected into each case row's `context` envelope.
    signals:
      group_column: source_name
      timestamp_column: "Timestamp"
      case_id_column: "Case_ID"
      # Each metric entry maps a signals-table column to one or more eval metrics.
      # `metric_names` restricts which eval metrics this signal appears under when
      # the caller passes ?metric_name=. Omit `metric_names` (or leave empty) to
      # make the signal universal — returned for any metric_name filter value.
      metrics:
        - key: "Sentiment Category__sentiment"
          match_values: ["frustrated", "confused"]
          # no metric_names → universal (appears regardless of metric_name filter)
        - key: "Decision Analysis__decision_status"
          match_values: ["fail"]
          metric_names: ["UW Completeness", "UW Faithfulness"]
        - key: "Hallucination__detected"
          match_values: ["true"]
          metric_names: ["UW Faithfulness"]
      detail_columns:
        - "Sentiment Category__sentiment"
        - "Sentiment Category__explanation"
        - "Decision Analysis__decision_status"
        - "Timestamp"
