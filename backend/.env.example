# AXIS Backend Environment Variables

# Database Connection Defaults (optional - pre-fills the connection form)
# Option 1: Full connection URL (recommended for Neon, Supabase, Railway, etc.)
# DB_URL=postgresql://user:password@host:5432/database?sslmode=require

# Option 2: Individual fields
# DB_HOST=db.example.com
# DB_PORT=5432
# DB_NAME=mydb
# DB_USER=postgres
# DB_PASSWORD=secret
# DB_SSL_MODE=require

# Default table to auto-select (optional)
# Format: "schema.table" or just "table" (defaults to public schema)
# DB_TABLE=public.evaluations

# ─── Copilot Tracing (optional) ──────────────────────────────────────────────
# Axion auto-detects provider from credentials. Set TRACING_MODE to override.
# TRACING_MODE=langfuse          # langfuse | otel | logfire | opik | noop

# Langfuse:
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # default; use https://eu.cloud.langfuse.com for EU
# LANGFUSE_ENVIRONMENT=production                # optional deployment label

# OTEL:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Default when nothing is set: noop (no traces, no network calls)
